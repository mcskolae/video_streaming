# Variables NON secrètes de production. Copier vers .env.prod (ignoré par Git).
# Les secrets (APP_KEY, DB_PASSWORD, TMDB_API_KEY) vont dans ./secrets/, jamais ici.
DOMAIN=homeflix.example.org
MEDIA_PATH=/srv/media

APP_NAME=HomeFlix
APP_LOCALE=fr
APP_ENV=production
APP_DEBUG=false
APP_URL=https://homeflix.example.org
LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=homeflix
DB_USERNAME=homeflix

SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=redis
CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis

# Médias : racine dans les conteneurs app et worker (le dossier de l'hôte est MEDIA_PATH).
MEDIA_ROOT=/srv/media
MEDIA_DELETE_SOURCE=true
